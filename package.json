{
  "name": "mainland-dispatch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "warn"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false,
    "unrs-resolver": false
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "generate:favicon:check": "node scripts/generate-favicon.mjs --check",
    "baseline:check": "corepack npm run generate:favicon:check && node scripts/baseline-contract-check.mjs",
    "toolchain:check": "node scripts/typescript-toolchain-check.mjs",
    "typecheck": "next typegen && node node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:compat": "next typegen && node node_modules/typescript/bin/tsc --noEmit",
    "test": "jest --watchman=false",
    "test:ci": "jest --runInBand --coverage --watchman=false",
    "test:link-audit": "node --test scripts/link-audit.node-test.mjs",
    "test:boundary-audit": "node --test scripts/public-boundary-audit.node-test.mjs",
    "audit:public-boundary": "node scripts/public-boundary-audit.mjs",
    "link:audit:static": "node scripts/link-audit.mjs static",
    "link:audit:live": "node scripts/link-audit.mjs live",
    "audit:production": "corepack npm audit --omit=dev --audit-level=high",
    "audit:dependencies": "corepack npm audit --audit-level=high",
    "audit:toolchain": "corepack npm run audit:dependencies",
    "test-all": "corepack npm run format:check && corepack npm run lint && corepack npm run baseline:check && corepack npm run toolchain:check && corepack npm run typecheck && corepack npm run typecheck:compat && corepack npm run test:ci && corepack npm run test:link-audit && corepack npm run test:boundary-audit && corepack npm run build && corepack npm run audit:public-boundary && corepack npm run link:audit:static",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@xstate/react": "6.1.0",
    "clsx": "2.1.1",
    "maplibre-gl": "6.13.0",
    "next": "16.4.0",
    "postcss": "8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "xstate": "5.33.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": "prettier --write"
  }
}
